{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Timer",
  "version": "0.1.0",
  "identifier": "com.example.visualtimer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Visual Timer",
        "width": 160,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
